# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/room_rento?retryWrites=true&w=majority
# For local Docker: MONGO_URI=mongodb://mongo:27017/room_rento

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Cookie ──────────────────────────────────────────────────────────────────
COOKIE_SECRET=change_me_cookie_secret_min_32_chars

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=room_rento_listings

# ─── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3000

# ─── Email (Nodemailer / Gmail) ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Room Rento <noreply@roomrento.in>

# ─── Redis (optional caching) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ─── Admin auto-approve verified owners ───────────────────────────────────────
AUTO_APPROVE_VERIFIED_OWNERS=false
